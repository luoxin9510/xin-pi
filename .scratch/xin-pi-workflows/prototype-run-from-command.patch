@@ -42,6 +42,36 @@ export default function subagent(pi: ExtensionAPI) {
 			"List this session's subagents; `stop` stops everything running; `worktrees` lists and removes kept worktrees",
 		handler: (args, ctx) => subagentsCommand(ctx, args),
 	});
+	// PROTOTYPE: /wfproto <file> runs a script file as a codemode script with no model tool call.
+	pi.registerCommand("wfproto", {
+		description: "prototype",
+		handler: async (args, ctx) => {
+			const { readFileSync, appendFileSync } = await import("node:fs");
+			const { executeCodemode } = await import("../codemode/execute.ts");
+			const { codemodeScripts } = await import("../codemode/scripts.ts");
+			const out = (line: string) => appendFileSync(process.env.XPI_WFPROTO_OUT!, `${line}\n`);
+			const id = `workflow-${Date.now()}`;
+			const toolCtx = (ctx as any).createToolContext(id, undefined);
+			const off = codemodeScripts.subscribe({
+				onStart: (s) => out(`onStart ${s.id} ${s.toolCallId} ${s.state}`),
+				onBackground: (s) => out(`onBackground ${s.id}`),
+				onEnd: (s, o) => out(`onEnd ${s.id} background=${o.background} stopped=${o.stopped} error=${o.error?.message} result=${JSON.stringify(o.result?.content)}`),
+			});
+			try {
+				toolCtx.detachNestedCalls?.();
+				const run = executeCodemode(id, { code: readFileSync(args.trim(), "utf8") }, undefined, undefined, toolCtx, {});
+				setTimeout(() => out(`moved=${codemodeScripts.backgroundAll(ctx.sessionManager.getSessionId())}`), 300);
+				const early = await run;
+				out(`early ${JSON.stringify(early.content).slice(0, 300)} details.background=${(early.details as any)?.background}`);
+				await new Promise((r) => setTimeout(r, 2500));
+				toolCtx.releaseNestedCalls?.();
+			} catch (e) {
+				out(`threw ${(e as Error).stack}`);
+			} finally {
+				off();
+			}
+		},
+	});
 	pi.on("agent_start", track);
 	pi.on("agent_end", track);
 
