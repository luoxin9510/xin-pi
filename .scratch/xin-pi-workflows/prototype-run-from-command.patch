diff --git a/packages/xpi-coding-agent/src/extensions/subagent/index.ts b/packages/xpi-coding-agent/src/extensions/subagent/index.ts
index 436b74027..a2d213498 100644
--- a/packages/xpi-coding-agent/src/extensions/subagent/index.ts
