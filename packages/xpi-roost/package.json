{
	"name": "xpi-roost",
	"version": "1.13.0",
	"private": true,
	"description": "Background sessions for xpi: the roost daemon, the PTY host and their shared library",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./session": {
			"source": "./src/session.ts",
			"types": "./dist/session.d.ts",
			"import": "./dist/session.js"
		},
		"./hub": {
			"source": "./src/hub/index.ts",
			"types": "./dist/hub/index.d.ts",
			"import": "./dist/hub/index.js"
		},
		"./daemon": {
			"source": "./src/daemon/main.ts",
			"import": "./dist/daemon/main.js",
			"default": "./dist/daemon/main.js"
		},
		"./host": {
			"source": "./src/host/main.ts",
			"import": "./dist/host/main.js",
			"default": "./dist/host/main.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"docs"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test:roost": "vitest --run",
		"docs:protocol": "node test/support/protocol-doc.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@xterm/addon-serialize": "0.14.0",
		"@xterm/headless": "6.0.0",
		"node-pty": "1.1.0",
		"xpi-tui": "1.13.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.12"
	}
}
