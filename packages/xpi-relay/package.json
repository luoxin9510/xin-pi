{
	"name": "xpi-relay",
	"version": "1.14.0",
	"private": true,
	"description": "Relay for xpi: a lead model plans and reviews, a worker model builds, in one session. The control flow, the records and the host interface",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"relay",
		"agents",
		"models"
	],
	"author": "luoxin9510",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luoxin9510/xin-pi.git",
		"directory": "packages/xpi-relay"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"typebox": "1.3.27",
		"xpi-ai": "1.14.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.12",
		"xpi-agent-core": "1.14.0"
	}
}
