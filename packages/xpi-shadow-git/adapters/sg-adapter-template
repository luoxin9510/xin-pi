#!/bin/sh
# sg-adapter-template: the adapter interface, with the questions an adapter for your host VCS has to answer.
#
# An adapter is an executable named sg-adapter-<name>, found in XPI_SG_ADAPTER_PATH (default <store>/adapters), then in
# the adapters shipped with xin-pi, then on PATH. It is the only part of shadow-git that talks to the host VCS. Copy this
# file to sg-adapter-<yourname>, make it executable, and fill in each op. Run as `xpi sg init <name> --adapter <yourname>`.
#
# Called as:   sg-adapter-<name> <op> [args]
#   cwd                the workspace root
#   XPI_SG_WORKSPACE   the workspace root, absolute
#   XPI_SG_SCOPE       space-separated paths the adapter works on, relative to the root; empty is the whole workspace
#   XPI_SG_LOCAL_ONLY  space-separated globs the adapter must never change or delete (paths git tracks, but are never
#                      checked in; a glob that ends in / means everything below it). They are git pathspec globs
#                      (`:(glob)`): `*` does not cross a /, and `**/x` also matches a root `x`. Shell `case` patterns
#                      differ, so do not match them with `case`; ask git, as sg-adapter-plain does: put the candidate
#                      paths in a scratch index (GIT_INDEX_FILE, `update-index --add --info-only --index-info`) and run
#                      `ls-files -- ':(glob)<glob>'` on it.
#   XPI_SG_GIT_DIR     the shadow repo, for an adapter that wants to read its settings, such as
#                      "$XPI_SG_GIT" --git-dir "$XPI_SG_GIT_DIR" config --get shadow.<yourname>.<key>
#   XPI_SG_GIT         the git binary
# A non-zero exit is a failure; its stderr is shown to the user unchanged. Paths are relative to the workspace root.
# The tracked files of the shadow repo's `host` branch are `git --git-dir "$XPI_SG_GIT_DIR" ls-tree -r --name-only
# refs/heads/host`: an adapter that removes files should remove only what was tracked, never ignored build output.
#
# This template fails every op that needs your decision, so that it cannot be used by accident.
set -eu
set -f

op="${1:-}"
[ $# -gt 0 ] && shift

todo() {
	echo "sg-adapter-template: op '$1' is not implemented; copy this file and fill it in" >&2
	exit 1
}

case "$op" in
metadata)
	# Print the host VCS's own files and directories, one path per line, relative to the workspace root.
	# They are never tracked and are hidden in sandboxes. Every line is anchored to the root (written as /<path> in
	# info/exclude): only root-relative paths belong here. A name the VCS repeats in every directory (a metadata
	# directory in each subdirectory, say) is not a root path: print it from `excludes` as a pattern instead.
	# Questions: which names does your VCS put at the root of the workspace? Which does it put in every directory?
	todo metadata
	;;
excludes)
	# Print gitignore patterns, one per line, for other paths git must never track: build outputs, caches, editor files, and host VCS
	# names that repeat in every directory (patterns such as `.hostvcs-meta/`, not anchored to the root).
	# An empty output is allowed.
	todo excludes
	;;
prepare)
	# Make every in-scope file a writable regular file, so that an agent can edit it and git can track it.
	# Questions: are files read-only until checked out? Are some of them links into a shared cache? Replacing a link by
	# a copy must not change the cache. Does your VCS record the writable state, and does making a file writable tell it
	# the file is being edited?
	todo prepare
	;;
update)
	# Bring the workspace to the latest host state within the scope, and print a one-line label (a version or a time).
	# Leave the XPI_SG_LOCAL_ONLY paths alone. Delete files the host deleted, but not ignored build outputs.
	# Questions: does your VCS refuse to update over local edits? (The tree is clean when this runs.) Does an update need
	# a lock, a view or a server? How do you tell "no change" apart from a failure?
	todo update
	;;
checkin)
	# stdin: one change per line, `A`, `M` or `D`, a TAB, a path. --message-file <file> holds the commit message.
	# Check in exactly these changes as one host operation, or fail with no partial effect where the host allows it.
	# Questions: does a check-in need a lock first, and who releases it on failure? Must new files be added to the host
	# VCS before they can be checked in, and deleted ones removed? Does your VCS check in the files from the workspace,
	# so that the workspace and the check-in agree? What does it do when the host moved since the last update?
	# Suggested patterns for `shadow.blockCommand` (host VCS write commands that agents must not run): the commands of
	# your VCS that check in, add, remove, revert or update files.
	todo checkin
	;;
status)
	# Print a short summary of the host side, at most 20 lines of free text: locks held, newer versions available.
	# An empty output is allowed.
	;;
*)
	echo "sg-adapter-template: unknown op '$op' (metadata, excludes, prepare, update, checkin, status)" >&2
	exit 2
	;;
esac
