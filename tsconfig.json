{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"xpi-telemetry": ["./packages/xpi-telemetry/src/index.ts"],
			"xpi-telemetry/testing": ["./packages/xpi-telemetry/src/testing/index.ts"],
			"xpi-telemetry/render": ["./packages/xpi-telemetry/src/render.ts"],
			"xpi-codemode": ["./packages/xpi-codemode/src/index.ts"],
			"xpi-codemode/cloudflare": ["./packages/xpi-codemode/src/cloudflare.ts"],
			"xpi-codemode/declarations": ["./packages/xpi-codemode/src/declarations.ts"],
			"xpi-codemode/portable": ["./packages/xpi-codemode/src/portable.ts"],
			"xpi-codemode/source": ["./packages/xpi-codemode/src/source.ts"],
			"xpi-codemode/worker": ["./packages/xpi-codemode/src/runtime/worker.ts"],
			"xpi-schema": ["./packages/xpi-schema/src/index.ts"],
			"xpi-schema/formats": ["./packages/xpi-schema/src/formats/index.ts"],
			"xpi-mcp": ["./packages/xpi-mcp/src/index.ts"],
			"xpi-mcp/oauth": ["./packages/xpi-mcp/src/oauth/index.ts"],
			"xpi-mcp/testing": ["./packages/xpi-mcp/src/testing/index.ts"],
			"xpi-ai": ["./packages/xpi-ai/src/index.ts"],
			"xpi-ai/oauth": ["./packages/xpi-ai/src/oauth.ts"],
			"xpi-ai/*": ["./packages/xpi-ai/src/*.ts", "./packages/xpi-ai/src/providers/*.ts"],
			"xpi-ai/dist/*": ["./packages/xpi-ai/src/*"],
			"xpi-agent-core": ["./packages/xpi-agent-core/src/index.ts"],
			"xpi-coding-agent": ["./packages/xpi-coding-agent/src/index.ts"],
			"xpi-coding-agent/hooks": ["./packages/xpi-coding-agent/src/core/hooks/index.ts"],
			"xpi-coding-agent/*": ["./packages/xpi-coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"xpi-roost": ["./packages/xpi-roost/src/index.ts"],
			"xpi-roost/session": ["./packages/xpi-roost/src/session.ts"],
			"xpi-tui": ["./packages/xpi-tui/src/index.ts"],
			"xpi-tui/*": ["./packages/xpi-tui/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/xpi-ai/catalog/**/*", "packages/xpi-coding-agent/examples/**/*", "packages/xpi-agent-core/examples/**/*"],
	"exclude": ["**/dist/**", "packages/xpi-coding-agent/examples/extensions/**", "packages/xpi-coding-agent/test/suite/regressions/8261-subagent-project-trust.test.ts", "packages/xpi-coding-agent/test/subagent-extension.test.ts"]
}
